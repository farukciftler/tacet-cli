          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AUTORISATIONS"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한"
          }
        },
        "pt-BR" : {
