    "Sohbetlerde kendinden bahsettikçe burada görünür — ve yalnızca burada durur." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du in Unterhaltungen etwas über dich erzählst, erscheint es hier – und bleibt auch nur hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you mention things about yourself in conversations, they show up here — and stay only here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que hablas de ti en las conversaciones, aparece aquí, y solo se queda aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que tu parles de toi dans les conversations, cela apparaît ici — et n’en sort pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話の中で自分のことを話すと、ここに表示されます。そして、ここにしか残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화에서 자신에 대해 이야기하면 여기에 나타나며, 오직 여기에만 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme você fala sobre si nas conversas, aparece aqui — e fica somente aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在对话中提到自己的事情时，会显示在这里 — 而且只留在这里。"
          }
        }
      }
    },
