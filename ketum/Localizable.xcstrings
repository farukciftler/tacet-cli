    "Sil" : {

    },
    "sirr" : {

    },
    "sirr tamamen bu cihazda çalışır. Sorduğun, takvimin, notların cihazdan çıkmaz. İnternete çıkmaz." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr läuft vollständig auf diesem Gerät. Was du fragst, dein Kalender und deine Notizen verlassen es nicht. Es geht nicht ins Internet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr runs entirely on this device. What you ask, your calendar, and your notes never leave it. Nothing goes online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr funciona por completo en este dispositivo. Lo que preguntas, tu calendario y tus notas no salen de él. No se conecta a internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr fonctionne entièrement sur cet appareil. Ce que tu demandes, ton calendrier et tes notes n'en sortent pas. Aucune connexion à internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr はすべてこの端末内で動作します。聞いた内容、カレンダー、メモが端末の外に出ることはありません。インターネットにも接続しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr은 전적으로 이 기기에서 작동합니다. 물어본 내용, 캘린더, 메모가 기기 밖으로 나가지 않습니다. 인터넷에도 연결되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sirr funciona inteiramente neste dispositivo. O que você pergunta, seu calendário e suas notas não saem dele. Não vai para a internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr 完全在本设备上运行。你的提问、日历和笔记都不会离开设备，也不会联网。"
          }
        }
      }
    },
    "sirr tamamen bu cihazda çalışır. Takvimine bakabilir, hatırlatıcı kurabilir, notlarında arayabilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr läuft vollständig auf diesem Gerät. Es kann deinen Kalender einsehen, Erinnerungen einrichten und deine Notizen durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr runs entirely on this device. It can check your calendar, set reminders, and search your notes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr funciona por completo en este dispositivo. Puede consultar tu calendario, crear recordatorios y buscar en tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr fonctionne entièrement sur cet appareil. Il peut consulter ton calendrier, créer des rappels et chercher dans tes notes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr はすべてこの端末内で動作します。カレンダーの確認、リマインダーの設定、メモの検索ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr은 전적으로 이 기기에서 작동합니다. 캘린더를 확인하고, 미리 알림을 설정하고, 메모를 검색할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sirr funciona inteiramente neste dispositivo. Ele pode ver seu calendário, criar lembretes e buscar em suas notas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr 完全在本设备上运行。它可以查看你的日历、设置提醒、搜索你的笔记。"
          }
        }
      }
    },
    "sirr yazıyor" : {
      "localizations" : {
        "de" : {
