    "Aşağıdan kur ya da sohbette iste: sabahları brifing hazırlayayım." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte unten eine ein oder frag einfach im Chat: Ich kann dir jeden Morgen ein Briefing erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set one up below, or just ask in chat: I can prepare a briefing each morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura una abajo o pídemelo en el chat: puedo prepararte un resumen cada mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configures-en une ci-dessous ou demande-le dans la conversation : je peux préparer un briefing chaque matin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下から設定するか、チャットで頼んでください。毎朝ブリーフィングを用意します。"
          }
