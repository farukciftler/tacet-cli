          }
        }
      }
    },
    "İzinler yalnızca sen bir şey istediğin anda kullanılır ve veri cihazdan çıkmaz; değiştirmek için iOS Ayarlar'a gidilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen werden nur in dem Moment genutzt, in dem du etwas verlangst, und keine Daten verlassen das Gerät; ändern kannst du sie in den iOS-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissions are used only the moment you ask for something, and no data leaves the device; change them in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos solo se usan en el momento en que pides algo y ningún dato sale del dispositivo; para cambiarlos, ve a Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations ne servent qu’au moment où tu demandes quelque chose, et aucune donnée ne quitte l’appareil ; modifie-les dans les Réglages iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス許可はあなたが何かを頼んだときにだけ使われ、データは端末から出ません。変更は iOS の「設定」から行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한은 사용자가 무언가를 요청하는 순간에만 사용되며 데이터는 기기를 벗어나지 않습니다. 변경은 iOS 설정에서 하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões são usadas apenas no momento em que você pede algo e nenhum dado sai do dispositivo; para alterar, vá aos Ajustes do iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "权限只在你提出请求的那一刻使用，数据不会离开设备；如需更改，请前往 iOS 设置。"
          }
        }
      }
    },
    "İzni açmak için dokun" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
