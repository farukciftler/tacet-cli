    "İZİNLER" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BERECHTIGUNGEN"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PERMISSIONS"
          }
        },
        "es" : {
