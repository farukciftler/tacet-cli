    "Göndermezsen sirr bu adımı atlar ve yapamadığını söyler." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es nicht sendest, überspringt sirr diesen Schritt und sagt dir, dass es nicht ging."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you don’t send it, sirr skips this step and tells you it couldn’t do it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no lo envías, sirr omite este paso y te dice que no pudo hacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu ne l’envoies pas, sirr saute cette étape et te dit qu’il n’a pas pu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信しない場合、sirr はこのステップを飛ばして、できなかったと伝えます。"
          }
