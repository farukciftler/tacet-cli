    "Takvim, kişi ve belge gibi verilerin bu sunucuya gönderilip gönderilmeyeceğini belirler." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, ob Daten wie Kalender, Kontakte und Dokumente an diesen Server gesendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determines whether data such as calendar, contacts and documents is sent to this server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determina si se envían a este servidor datos como el calendario, los contactos y los documentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détermine si des données comme le calendrier, les contacts et les documents sont envoyées à ce serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダー、連絡先、書類などのデータをこのサーバーに送信するかどうかを決めます。"
