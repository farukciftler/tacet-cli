    "Virgülle ayır." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Kommas trennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate with commas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepáralas con comas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sépare-les par des virgules."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カンマで区切ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉼표로 구분하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe por vírgulas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用逗号分隔。"
          }
        }
      }
    },
    "Virgülle ayır. Bu kelimelerden biri mesajda geçince beceri devreye girer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Kommas trennen. Die Fähigkeit greift, sobald eines dieser Wörter in deiner Nachricht vorkommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate with commas. The skill kicks in when one of these words appears in your message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepáralas con comas. La habilidad se activa cuando una de estas palabras aparece en tu mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sépare-les par des virgules. La compétence s’active dès qu’un de ces mots apparaît dans ton message."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カンマで区切ってください。これらの語がメッセージに含まれるとスキルが働きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉼표로 구분하세요. 메시지에 이 단어 중 하나가 나오면 스킬이 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe por vírgulas. A habilidade entra em ação quando uma dessas palavras aparece na sua mensagem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用逗号分隔。消息中出现其中任一词时，技能即会启用。"
          }
        }
      }
    },
    "Virgülle ayır. Bu kelimelerden biri mesajda geçince not sirr'e verilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Kommas trennen. Sobald eines dieser Wörter in einer Nachricht vorkommt, wird die Notiz an sirr weitergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate with commas. When one of these words appears in a message, the note is given to sirr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepáralas con comas. Cuando una de estas palabras aparece en un mensaje, la nota se le pasa a sirr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sépare-les par des virgules. Dès que l’un de ces mots apparaît dans un message, la note est transmise à sirr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カンマで区切ります。これらの単語のいずれかがメッセージに現れると、そのメモが sirr に渡されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쉼표로 구분하세요. 이 단어 중 하나가 메시지에 나오면 해당 메모가 sirr에게 전달됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separe por vírgulas. Quando uma dessas palavras aparece em uma mensagem, a nota é passada ao sirr."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用逗号分隔。当消息中出现其中任一词时，该备忘录会提供给 sirr。"
          }
        }
      }
    },
