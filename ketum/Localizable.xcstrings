            "value" : "sirr n’a encore rien appris."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sirr はまだ何も学んでいません。"
          }
        },
        "ko" : {
          "stringUnit" : {
