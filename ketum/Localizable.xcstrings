    "Apple Intelligence kapalı. Ayarlar > Apple Intelligence ve Siri'den açtıktan sonra tekrar dene." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ist deaktiviert. Aktiviere es unter „Einstellungen“ > „Apple Intelligence & Siri“ und versuch es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence is off. Turn it on in Settings > Apple Intelligence & Siri, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence está desactivado. Actívalo en Ajustes > Apple Intelligence y Siri e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est désactivé. Active-le dans Réglages > Apple Intelligence et Siri, puis réessaie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence がオフです。「設定」＞「Apple Intelligence と Siri」でオンにしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 꺼져 있습니다. 설정 > Apple Intelligence 및 Siri에서 켠 뒤 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence está desativado. Ative em Ajustes > Apple Intelligence e Siri e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 已关闭。请在“设置”>“Apple Intelligence 与 Siri”中开启后重试。"
          }
        }
      }
    },
