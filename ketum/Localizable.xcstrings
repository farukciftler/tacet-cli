    "Bu notlar cihazından çıkmaz. İlgili olduklarında sirr onlara bakar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Notizen verlassen dein Gerät nie. sirr sieht sie sich an, wenn sie relevant sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These notes never leave your device. sirr looks at them when they’re relevant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas notas no salen de tu dispositivo. sirr las consulta cuando son relevantes."
