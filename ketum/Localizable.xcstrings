        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에서 설정하거나 대화에서 요청하세요. 매일 아침 브리핑을 준비해 드립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
