    "Kapalı not saklanır ama sirr'e hiç verilmez." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ausgeschaltete Notiz wird aufbewahrt, aber nie an sirr weitergegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A note that’s off is kept but never given to sirr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota desactivada se conserva, pero nunca se le pasa a sirr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note désactivée est conservée mais n’est jamais transmise à sirr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフのメモは保存されますが、sirr に渡されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼진 메모는 보관되지만 sirr에게 전달되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nota desativada é mantida, mas nunca é passada ao sirr."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭的备忘录会保留，但绝不会提供给 sirr。"
          }
        }
      }
    },
    "Kapalıyken sirr aramayı hiç kullanmaz." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das aus ist, nutzt sirr die Suche nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is off, sirr never uses search."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está desactivado, sirr nunca usa la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand c’est désactivé, sirr n’utilise jamais la recherche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフのとき、sirr が検索を使うことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼져 있으면 sirr는 검색을 전혀 사용하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando está desativado, o sirr nunca usa a busca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，sirr 不会使用搜索。"
          }
        }
      }
    },
