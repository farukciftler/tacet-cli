    "Şu an bunu yapamadım. Bir daha sorar mısın?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat gerade nicht geklappt. Fragst du noch einmal?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I couldn't do that just now. Could you ask again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pude hacerlo ahora. ¿Puedes preguntármelo de nuevo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n'ai pas pu le faire à l'instant. Peux-tu redemander ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はできませんでした。もう一度聞いてもらえますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방금은 하지 못했어요. 다시 물어봐 주시겠어요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consegui fazer isso agora. Pode perguntar de novo?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我刚才没能完成。可以再问一次吗？"
          }
        }
      }
    },
    "Sunucu %lld döndürdü. Adres doğru olsa da arama bu yoldan açılmıyor olabilir." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat %lld zurückgegeben. Die Adresse kann stimmen, aber die Suche ist unter diesem Pfad womöglich nicht erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server returned %lld. The address may be right, but search may not be exposed at this path."
