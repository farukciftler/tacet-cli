          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返答の言語"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답변 언어"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
