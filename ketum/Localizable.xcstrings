    "Bu adımı sürdürmek için iOS Ayarlar'dan sirr'e izin vermen gerekiyor. Veri yine cihazdan çıkmaz." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mit diesem Schritt fortzufahren, musst du sirr in den iOS-Einstellungen die Berechtigung erteilen. Deine Daten verlassen das Gerät weiterhin nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To continue with this step you need to grant sirr permission in iOS Settings. Your data still never leaves the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para continuar con este paso debes conceder permiso a sirr en Ajustes de iOS. Tus datos siguen sin salir del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour poursuivre cette étape, tu dois accorder l’autorisation à sirr dans les Réglages iOS. Tes données ne quittent toujours pas l’appareil."
