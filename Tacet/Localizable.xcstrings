    "%@ was given.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde gegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se entregó %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été fourni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を渡しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 전달했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi entregue."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提供 %@。"
          }
        }
      }
    },
    "%@ was saved, but the access key couldn’t be written to the device keychain. Enter the key again from the connection details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde gespeichert, aber der Zugriffsschlüssel konnte nicht im Schlüsselbund des Geräts abgelegt werden. Gib den Schlüssel in den Verbindungsdetails erneut ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se guardó, pero la clave de acceso no se pudo escribir en el llavero del dispositivo. Vuelve a introducir la clave desde los detalles de la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été enregistré, mais la clé d’accès n’a pas pu être écrite dans le trousseau de l’appareil. Saisis à nouveau la clé depuis les détails de la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は保存されましたが、アクセスキーをデバイスのキーチェーンに書き込めませんでした。接続の詳細からキーを入力し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 저장되었지만 액세스 키를 기기 키체인에 기록하지 못했습니다. 연결 세부 정보에서 키를 다시 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi salvo, mas a chave de acesso não pôde ser gravada no chaveiro do dispositivo. Digite a chave novamente nos detalhes da conexão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kaydedildi ama erişim anahtarı cihaz kasasına yazılamadı. Anahtarı bağlantı ayrıntısından yeniden girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已保存，但访问密钥无法写入设备钥匙串。请在连接详情中重新输入密钥。"
          }
        }
      }
    },
    "%@ will be deleted. Its key is removed from the Keychain; traces in past conversations are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird gelöscht. Der Schlüssel wird aus dem Schlüsselbund entfernt; Spuren in früheren Unterhaltungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará %@. Su clave se quita del llavero; los rastros en conversaciones anteriores se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera supprimé. Sa clé est retirée du trousseau ; les traces dans les conversations passées sont conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除します。キーはキーチェーンから削除されますが、過去の会話に残る記録は消えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제합니다. 키는 키체인에서 제거되지만 지난 대화에 남은 기록은 지워지지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será excluído. A chave é removida das Chaves; os rastros em conversas anteriores são mantidos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silinecek. Anahtarı Keychain'den kaldırılır; geçmiş sohbetlerdeki izler silinmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除 %@。其密钥会从钥匙串中移除；过往对话中的记录会保留。"
          }
        }
      }
    },
