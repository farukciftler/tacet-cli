          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスを読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 읽지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o endereço."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres okunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该地址。"
          }
        }
      }
    },
    "The address couldn’t be read. It must start with https://; plain http is accepted only for addresses on your own local network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse konnte nicht gelesen werden. Sie muss mit https:// beginnen; einfaches http wird nur für Adressen in deinem lokalen Netzwerk akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la dirección. Debe empezar por https://; el http sin cifrar solo se acepta en direcciones de tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse n’a pas pu être lue. Elle doit commencer par https:// ; le http simple n’est accepté que pour les adresses de ton réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスを読み取れませんでした。https:// で始まる必要があります。暗号化なしの http は自分のローカルネットワーク上のアドレスでのみ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 읽지 못했습니다. https://로 시작해야 하며, 암호화되지 않은 http는 사용자의 로컬 네트워크 주소에서만 허용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o endereço. Ele precisa começar com https://; http sem criptografia só é aceito em endereços da sua rede local."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres okunamadı. https:// ile başlamalı; düz http yalnızca kendi yerel ağındaki adreslerde kabul edilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该地址。地址必须以 https:// 开头；仅本地网络内的地址才接受普通 http。"
          }
        }
      }
    },
