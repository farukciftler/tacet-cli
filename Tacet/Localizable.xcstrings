      }
    },
    "A note that’s off is kept but never given to Tacet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ausgeschaltete Notiz wird aufbewahrt, aber nie an Tacet weitergegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota desactivada se conserva, pero nunca se le pasa a Tacet."
          }
