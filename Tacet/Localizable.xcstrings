    "Connects to the server and fetches its tool list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet sich mit dem Server und ruft dessen Werkzeugliste ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conecta al servidor y obtiene su lista de herramientas."
          }
        },
