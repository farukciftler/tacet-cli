    "The address couldn’t be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la dirección."
          }
        },
        "fr": {
