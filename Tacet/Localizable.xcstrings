      }
    },
    "Gives a file Tacet created to Shortcuts. The file can leave the device, so you have to grant permission separately inside Tacet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt eine von Tacet erstellte Datei an Kurzbefehle. Die Datei kann das Gerät verlassen; deshalb musst du die Erlaubnis in Tacet gesondert erteilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega a Atajos un archivo creado por Tacet. El archivo puede salir del dispositivo, así que debes dar el permiso aparte dentro de Tacet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournit à Raccourcis un fichier créé par Tacet. Le fichier peut quitter l’appareil ; tu dois donc accorder l’autorisation séparément dans Tacet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacet が作ったファイルをショートカットに渡します。ファイルは端末の外に出る可能性があるため、許可は Tacet の中で別途与える必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacet이 만든 파일을 단축어에 전달합니다. 파일이 기기 밖으로 나갈 수 있으므로 Tacet 안에서 따로 허용해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega aos Atalhos um arquivo criado pelo Tacet. O arquivo pode sair do aparelho; por isso você precisa dar a permissão separadamente dentro do Tacet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacet'in ürettiği bir dosyayı Kısayollar'a verir. Dosya cihazdan çıkabilir; bu yüzden izni Tacet'te ayrıca vermen gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Tacet 生成的文件提供给“快捷指令”。该文件可能离开设备，因此你需要在 Tacet 内单独授权。"
          }
        }
      }
    },
