    "On an iPhone that can run Apple Intelligence, Tacet works just as it is. Your chats, documents and settings stay here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem iPhone, das Apple Intelligence unterstützt, läuft Tacet genauso. Deine Chats, Dokumente und Einstellungen bleiben hier erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPhone compatible con Apple Intelligence, Tacet funciona tal cual. Tus chats, documentos y ajustes se quedan aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un iPhone compatible avec Apple Intelligence, Tacet fonctionne tel quel. Tes conversations, documents et réglages restent ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence を動かせる iPhone なら、Tacet はそのまま動きます。チャット、書類、設定はここに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 실행할 수 있는 iPhone에서는 Tacet이 그대로 작동합니다. 대화, 문서, 설정은 여기에 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um iPhone que roda a Apple Intelligence, o Tacet funciona do mesmo jeito. Suas conversas, documentos e ajustes continuam aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence çalıştırabilen bir iPhone'da Tacet olduğu gibi çalışır. Sohbetlerin, belgelerin ve ayarların burada durmaya devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在支持 Apple 智能的 iPhone 上，Tacet 会照常工作。你的对话、文档和设置仍留在这里。"
          }
        }
      }
    },
    "On your device": {
      "localizations": {
