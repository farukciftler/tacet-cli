    "Give to Shortcuts: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Kurzbefehle geben: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a Atajos: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir à Raccourcis : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットに渡す：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어에 전달: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornecer aos Atalhos: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
