    "Apple Intelligence is off. Turn it on in Settings > Apple Intelligence & Siri, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es unter „Einstellungen“ > „Apple Intelligence & Siri“ und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Ajustes > Apple Intelligence y Siri e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Active-le dans Réglages > Apple Intelligence et Siri, puis réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence がオフです。「設定」＞「Apple Intelligence と Siri」でオンにしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. 설정 > Apple Intelligence 및 Siri에서 켠 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence está desativado. Ative em Ajustes > Apple Intelligence e Siri e tente de novo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kapalı. Ayarlar > Apple Intelligence ve Siri'den açtıktan sonra tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已关闭。请在“设置”>“Apple Intelligence 与 Siri”中开启后重试。"
          }
        }
      }
    },
    "As you mention things about yourself in conversations, they show up here — and stay only here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du in Unterhaltungen etwas über dich erzählst, erscheint es hier – und bleibt auch nur hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A medida que hablas de ti en las conversaciones, aparece aquí, y solo se queda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À mesure que tu parles de toi dans les conversations, cela apparaît ici — et n’en sort pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の中で自分のことを話すと、ここに表示されます。そして、ここにしか残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에서 자신에 대해 이야기하면 여기에 나타나며, 오직 여기에만 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conforme você fala sobre si nas conversas, aparece aqui — e fica somente aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetlerde kendinden bahsettikçe burada görünür — ve yalnızca burada durur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你在对话中提到自己的事情时，会显示在这里 — 而且只留在这里。"
          }
        }
      }
    },
