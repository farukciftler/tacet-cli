    "Attach a document with the paper clip in the input field; Tacet summarizes it, answers questions from it, turns it into a table.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häng über die Büroklammer im Eingabefeld ein Dokument an; Tacet fasst es zusammen, beantwortet Fragen daraus und macht eine Tabelle daraus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta un documento con el clip del campo de entrada; Tacet lo resume, responde preguntas sobre él y lo convierte en tabla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins un document avec le trombone du champ de saisie ; Tacet le résume, répond aux questions à partir de lui, le transforme en tableau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄のクリップから書類を添付すると、要約したり、そこから質問に答えたり、表に変換したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력란의 클립으로 문서를 첨부하세요. 요약하고, 그 안에서 질문에 답하고, 표로 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe um documento pelo clipe no campo de entrada; o Tacet resume, responde perguntas a partir dele e transforma em tabela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş alanındaki ataçla bir belge ekle; özetler, içinden soruya cevap verir, tabloya çevirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用输入框里的回形针附加一份文档；Tacet 会总结它、根据它回答问题、把它转成表格。"
          }
        }
      }
    },
