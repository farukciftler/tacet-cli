        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una previsualización del archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un aperçu du fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをプレビューします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 미리 봅니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualiza o arquivo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyayı önizler"
          }
        },
        "zh-Hans": {
