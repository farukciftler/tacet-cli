            "value": "Tacet の最後の書類を渡す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacet의 마지막 문서 전달"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornecer o último documento do Tacet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacet'in son belgesini ver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供 Tacet 的最新文档"
          }
        }
      }
    },
    "Give files to Shortcuts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien an Kurzbefehle geben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar archivos a Atajos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournir des fichiers à Raccourcis"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットにファイルを渡す"
          }
        },
        "ko": {
