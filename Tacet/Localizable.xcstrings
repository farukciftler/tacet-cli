          "stringUnit": {
            "state": "translated",
            "value": "Satır ekler, siler, başlığı değiştirir; yeni sürümü yazar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增删行、修改标题，并写出新版本。"
          }
        }
      }
    },
    "All learned notes are deleted. Conversations are kept. This can’t be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gelernten Notizen werden gelöscht. Unterhaltungen bleiben erhalten. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan todas las notas aprendidas. Las conversaciones se conservan. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les notes apprises sont supprimées. Les conversations sont conservées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習したメモをすべて削除します。会話は残ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습한 모든 메모가 삭제됩니다. 대화는 남습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as notas aprendidas são excluídas. As conversas são mantidas. Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenilen tüm notlar silinir. Sohbetler kalır. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除所有已学习的备忘录。对话会保留。此操作无法撤销。"
          }
        }
      }
    },
    "Always allow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer erlauben"
          }
        },
        "es": {
