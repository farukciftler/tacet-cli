          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dirección Streamable HTTP. El http simple solo se acepta en direcciones de la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une adresse Streamable HTTP. Le http simple n’est accepté que pour les adresses du réseau local."
