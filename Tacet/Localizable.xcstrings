          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 필요합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão necessária"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin gerekiyor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要权限"
          }
        }
      }
    },
    "Permissions are used only the moment you ask for something; what is read does not go out without your approval. Change them in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen werden nur genutzt, wenn du etwas verlangst; Gelesenes geht ohne deine Zustimmung nicht hinaus. Ändern in den iOS-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos se usan solo cuando pides algo; lo leído no sale sin tu aprobación. Cámbialos en Ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations ne servent qu'au moment où tu demandes quelque chose ; ce qui est lu ne sort pas sans ton accord. Modifie-les dans Réglages iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限はあなたが何かを頼んだときだけ使われます。読み取った内容はあなたの承認なしに外へ出ません。変更は iOS の設定から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한은 무언가를 요청한 순간에만 사용됩니다. 읽은 내용은 승인 없이 밖으로 나가지 않습니다. 변경은 iOS 설정에서."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As permissões só são usadas quando você pede algo; o que é lido não sai sem sua aprovação. Altere em Ajustes do iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzinler yalnızca sen bir şey istediğin anda kullanılır; okunan veri sen onaylamadan dışarı gitmez. Değiştirmek için iOS Ayarlar'a gidilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限只在你提出请求的那一刻使用；读取的内容未经你同意不会外发。可在 iOS 设置中更改。"
          }
        }
      }
    },
