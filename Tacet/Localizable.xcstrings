    "What is 1,499 plus 18 percent VAT?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel ergibt 1.499 € plus 19 Prozent Mehrwertsteuer?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto son 1.499 más el 21 por ciento de IVA?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien font 1 499 plus 20 pour cent de TVA ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1,499円に消費税10パーセントを足すといくら？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1,499원에 부가세 10퍼센트를 더하면 얼마야?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dá 1.499 mais 18 por cento de imposto?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.499 TL'ye yüzde 18 KDV eklenirse kaç eder?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1499 元加上百分之十三的增值税是多少？"
          }
        }
      }
    },
    "What should be remembered?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woran soll sich Tacet erinnern?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se debe recordar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que faut-il retenir ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を覚えておきますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 기억할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que deve ser lembrado?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne hatırlansın?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要记住什么？"
          }
        }
      }
    },
    "What should it be about?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worum soll es gehen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sobre qué debe tratar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De quoi doit-il parler ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何についてにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇에 대한 내용으로 할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre o que deve ser?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne hakkında olsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容是关于什么？"
          }
        }
      }
    },
    "What would you like to ask?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du fragen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres preguntar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que veux-tu demander ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を聞きたいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 묻고 싶으세요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você quer perguntar?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne sormak istersin?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想问什么？"
          }
        }
      }
    },
    "What you ask stays here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du fragst, bleibt hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que preguntas se queda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu demandes reste ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞いたことは、ここに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물어본 내용은 여기에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você pergunta fica aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorduğun burada kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你问的都留在这里。"
          }
        }
      }
    },
    "What you write meanwhile isn’t lost; you can ask once it’s ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du in der Zwischenzeit schreibst, geht nicht verloren; sobald es bereit ist, kannst du fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que escribas mientras tanto no se pierde; podrás preguntar cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu écris entre-temps n’est pas perdu ; tu pourras demander dès que ce sera prêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間に書いたものは消えません。準備ができたら尋ねられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그동안 쓴 내용은 사라지지 않습니다. 준비되면 물어볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você escrever enquanto isso não se perde; é só perguntar quando estiver pronto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arada yazdığın kaybolmaz; hazır olduğunda sorabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这期间你写的内容不会丢失；准备好后就能提问。"
          }
        }
      }
    },
    "What's on tomorrow?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was steht morgen an?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué hay para mañana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'y a-t-il de prévu demain ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の予定は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 일정은?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
