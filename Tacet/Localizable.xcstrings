    "Passes your question to Tacet. The answer is produced in the app, in front of your eyes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet deine Frage an Tacet weiter. Die Antwort entsteht in der App, vor deinen Augen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tu pregunta a Tacet. La respuesta se genera en la app, delante de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmet ta question à Tacet. La réponse est produite dans l’app, sous tes yeux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問を Tacet に渡します。答えはアプリの中で、あなたの目の前で作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문을 Tacet에 전달합니다. 답은 앱 안에서, 당신이 보는 앞에서 만들어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminha sua pergunta ao Tacet. A resposta é produzida no app, diante dos seus olhos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu Tacet'e iletir. Yanıt uygulamada, senin gözünün önünde üretilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你的问题交给 Tacet。答案在 App 内、当着你的面生成。"
          }
        }
      }
    },
    "Permission needed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigung erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita permiso"
          }
        },
        "fr": {
