    "Brings back the first-launch welcome screen and the tool-trace hint.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Begrüßungsbildschirm des ersten Starts und den Hinweis zur Werkzeugspur erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a mostrar la pantalla de bienvenida inicial y la sugerencia sobre el rastro de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réaffiche l’écran d’accueil du premier lancement et l’astuce sur la trace des outils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動時のようこそ画面とツール履歴のヒントをもう一度表示します。"
          }
        },
        "ko": {
