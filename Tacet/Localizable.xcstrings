            "value": "この接続はもうありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 연결이 더 이상 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão não existe mais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı artık yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该连接已不存在。"
          }
        }
      }
    },
    "The file couldn’t be found.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est introuvable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 찾을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não foi encontrado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya bulunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到该文件。"
          }
        }
      }
    },
    "The file operation couldn’t be completed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateivorgang konnte nicht abgeschlossen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la operación con el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération sur le fichier n’a pas pu aboutir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル操作を完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 작업을 완료하지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a operação com o arquivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya işlemi tamamlanamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件操作未能完成。"
          }
        }
      }
    },
    "The first four and voice writing need permission. We don’t take it up front; the tool asks the moment you want it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ersten vier und das Schreiben mit der Stimme brauchen eine Berechtigung. Wir holen sie nicht vorab ein – das jeweilige Werkzeug fragt genau dann, wenn du es willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuatro primeros y la escritura por voz requieren permiso. No lo pedimos por adelantado: la herramienta pregunta en el momento en que tú lo quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre premiers et l’écriture à la voix nécessitent une autorisation. Nous ne la demandons pas à l’avance : l’outil demande au moment où tu le veux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の4つと声での入力は許可が必要です。前もっては求めません。あなたが望んだその瞬間に、そのツールが尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞의 네 가지와 음성 입력은 권한이 필요합니다. 미리 받지 않습니다. 당신이 원하는 바로 그 순간에 해당 도구가 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quatro primeiros e a escrita por voz pedem permissão. Não pedimos antes; a ferramenta pergunta no momento em que você quiser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk dördü ve sesle yazma izin ister. İzni önden almayız; sen istediğin an, o araç sorar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前四项和语音输入需要权限。我们不会提前索取；你想用的那一刻，工具才会询问。"
          }
        }
      }
    },
    "The line above is a tool trace: Tacet leaves one here for every tool it touches. Tap it to see exactly what it sent and received, raw.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile oben ist eine Werkzeugspur: Tacet hinterlässt hier für jedes benutzte Werkzeug eine. Tippe darauf, um roh zu sehen, was gesendet und empfangen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de arriba es un rastro de herramienta: Tacet deja uno aquí por cada herramienta que usa. Tócalo para ver en bruto qué envió y qué recibió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne ci-dessus est une trace d'outil : Tacet en laisse une pour chaque outil utilisé. Touchez-la pour voir brut ce qui a été envoyé et reçu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の行はツールの痕跡です。Tacet は使用したツールごとにここへ残します。タップすると送受信した内容が生のまま見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 줄은 도구 흔적입니다. Tacet은 사용한 모든 도구를 여기에 남깁니다. 누르면 무엇을 보내고 받았는지 원본 그대로 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha acima é um rastro de ferramenta: Tacet deixa um aqui para cada ferramenta que usa. Toque para ver em bruto o que enviou e recebeu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdaki satır bir araç izi: Tacet dokunduğu her aracı buraya bırakır. Üstüne dokunursan ne gönderip ne aldığını ham hâliyle görürsün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面那行是工具痕迹：Tacet 每用一个工具都会在此留下记录。点按即可查看它发送和接收的原始内容。"
          }
        }
      }
    },
    "The microphone wasn’t available just now. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon war gerade nicht verfügbar. Versuch es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no estaba disponible ahora mismo. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro n’était pas disponible à l’instant. Réessaie dans un moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを今は使えませんでした。少しあとでもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 마이크를 사용할 수 없었습니다. 잠시 후 다시 시도해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone não estava disponível agora. Tente de novo em instantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon şu an kullanılamadı. Biraz sonra yeniden dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风此刻不可用。请稍后再试。"
          }
        }
      }
    },
    "The model is small and runs on your device: its general world knowledge is weak. When it doesn’t know, it doesn’t make things up — it says so.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell ist klein und läuft auf dem Gerät: sein Allgemeinwissen ist schwach. Was es nicht weiß, erfindet es nicht – es sagt, dass es das nicht weiß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo es pequeño y se ejecuta en tu dispositivo: su conocimiento general del mundo es escaso. Cuando no sabe algo, no lo inventa: lo dice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est petit et fonctionne sur ton appareil : sa culture générale est faible. Quand il ne sait pas, il n’invente pas — il le dit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは小さく、端末の中で動きます。一般的な世界知識は弱いです。知らないことは作り話をせず、知らないと言います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 작고 기기 안에서 돌아갑니다: 일반 상식은 약합니다. 모르는 것은 지어내지 않고, 모른다고 말합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo é pequeno e roda no seu aparelho: o conhecimento geral de mundo é fraco. Quando não sabe, não inventa — diz que não sabe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model küçük ve cihazın içinde çalışıyor: genel dünya bilgisi zayıftır. Bilmediğinde uydurmaz, bilmediğini söyler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型很小，运行在你的设备里：通用世界知识较弱。不知道的事它不会编，会直说不知道。"
          }
        }
      }
    },
    "The model is still downloading. Try again in a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wird noch geladen. Versuch es in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo todavía se está descargando. Inténtalo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est encore en cours de téléchargement. Réessaie dans quelques minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをまだダウンロード中です。数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 아직 다운로드하는 중입니다. 몇 분 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda está sendo baixado. Tente de novo em alguns minutos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model hâlâ indiriliyor. Birkaç dakika sonra tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型仍在下载中，请几分钟后重试。"
          }
        }
      }
    },
    "The new language appears after you quit and reopen Tacet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache erscheint, nachdem du Tacet beendet und neu geöffnet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma aparece cuando cierras y vuelves a abrir Tacet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue apparaît après avoir quitté puis rouvert Tacet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語は Tacet を終了して開き直すと反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어는 Tacet을 종료했다가 다시 열면 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo idioma aparece depois de fechar e reabrir o Tacet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dil, Tacet'i kapatıp yeniden açtığında görünür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭并重新打开 Tacet 后，新语言才会生效。"
          }
        }
      }
    },
    "The page couldn’t be loaded: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite konnte nicht geladen werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la página: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page n’a pas pu être chargée : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを読み込めませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 로드하지 못했습니다: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a página: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa yüklenemedi: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载页面：%@"
          }
        }
      }
    },
    "The page couldn’t be verified": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite konnte nicht überprüft werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page n’a pas pu être vérifiée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを検証できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 확인하지 못했습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a página"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa doğrulanamadı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证页面"
          }
        }
      }
    },
    "The page didn’t load within 3 seconds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite wurde nicht innerhalb von 3 Sekunden geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página no se cargó en 3 segundos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page ne s’est pas chargée en 3 secondes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが3秒以内に読み込まれませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지가 3초 안에 로드되지 않았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A página não carregou em 3 segundos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa 3 saniye içinde yüklenmedi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面未在 3 秒内加载"
          }
        }
      }
    },
    "The page made a request to an address outside the file": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite hat eine Adresse außerhalb der Datei angefragt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página hizo una solicitud a una dirección fuera del archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page a fait une requête vers une adresse hors du fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページがファイル外のアドレスへリクエストしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지가 파일 외부 주소로 요청했습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A página fez uma solicitação a um endereço fora do arquivo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfa dosya dışı bir adrese istek yaptı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面向文件外的地址发起了请求"
          }
        }
      }
    },
    "The previous store couldn’t be opened, so it was kept as “%@” and Tacet started with a clean store. Nothing was deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Speicher ließ sich nicht öffnen, daher wurde er als „%@“ aufbewahrt und Tacet ist mit einem leeren Speicher gestartet. Nichts wurde gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el almacén anterior, así que se conservó con el nombre «%@» y Tacet comenzó con un almacén limpio. No se eliminó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage précédent n’a pas pu être ouvert : il a été conservé sous le nom « %@ » et Tacet a démarré avec un stockage vierge. Rien n’a été supprimé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のストレージを開けなかったため「%@」という名前で保管し、Tacet は新しいストレージで開始しました。何も削除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 저장소를 열 수 없어 “%@” 이름으로 보관했고, Tacet은 비어 있는 저장소로 시작했습니다. 아무것도 삭제되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento anterior não pôde ser aberto, então foi guardado como “%@” e o Tacet começou com um armazenamento limpo. Nada foi excluído."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki depo açılamadığı için “%@” adıyla saklandı ve Tacet temiz bir depoyla başladı. Hiçbir şey silinmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的存储无法打开，因此已以“%@”为名保留，Tacet 以全新存储启动。没有任何内容被删除。"
          }
        }
      }
    },
    "The search server didn’t return JSON.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Suchserver hat kein JSON zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de búsqueda no devolvió JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de recherche n’a pas renvoyé de JSON."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索サーバーが JSON を返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 서버가 JSON을 반환하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de busca não retornou JSON."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama sunucusu JSON döndürmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索服务器未返回 JSON。"
          }
        }
      }
    },
    "The server couldn’t be reached. The address wasn’t found, or the response didn’t arrive in time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server war nicht erreichbar. Die Adresse wurde nicht gefunden oder die Antwort kam nicht rechtzeitig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder al servidor. No se encontró la dirección o la respuesta no llegó a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas pu être joint. L’adresse est introuvable ou la réponse n’est pas arrivée à temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。アドレスが見つからないか、応答が時間内に届きませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결하지 못했습니다. 주소를 찾을 수 없거나 응답이 제때 오지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o servidor. O endereço não foi encontrado ou a resposta não chegou a tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamadı. Adres bulunamadı ya da yanıt zamanında gelmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问服务器。未找到该地址，或响应未及时返回。"
          }
        }
      }
    },
    "The server didn’t provide a readable schema.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat kein lesbares Schema geliefert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no proporcionó un esquema legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas fourni de schéma lisible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが読み取り可能なスキーマを返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 읽을 수 있는 스키마를 제공하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não forneceu um esquema legível."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu okunabilir bir şema vermedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未提供可读的架构。"
          }
        }
      }
    },
    "The server responded but didn’t return JSON. In the server’s settings.yml, formats: json must be enabled.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat geantwortet, aber kein JSON zurückgegeben. In der settings.yml des Servers muss formats: json aktiviert sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió pero no devolvió JSON. En el archivo settings.yml del servidor debe estar activado formats: json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu mais n’a pas renvoyé de JSON. Dans le fichier settings.yml du serveur, formats: json doit être activé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーは応答しましたが、JSON を返しませんでした。サーバーの settings.yml で formats: json を有効にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답했지만 JSON을 반환하지 않았습니다. 서버의 settings.yml 파일에서 formats: json이 켜져 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu, mas não retornou JSON. No arquivo settings.yml do servidor, formats: json precisa estar ativado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu yanıt verdi ama JSON döndürmedi. Sunucunun settings.yml dosyasında formats: json açık olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器已响应，但未返回 JSON。需在服务器的 settings.yml 中启用 formats: json。"
          }
        }
      }
    },
    "The server returned %lld. The address may be right, but search may not be exposed at this path.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat %lld zurückgegeben. Die Adresse kann stimmen, aber die Suche ist unter diesem Pfad womöglich nicht erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor devolvió %lld. La dirección puede ser correcta, pero quizá la búsqueda no esté disponible en esa ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a renvoyé %lld. L’adresse est peut-être correcte, mais la recherche n’est peut-être pas exposée à ce chemin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが %lld を返しました。アドレスは正しくても、このパスでは検索が公開されていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 %lld을(를) 반환했습니다. 주소가 맞더라도 이 경로에서는 검색이 열려 있지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor retornou %lld. O endereço pode estar certo, mas talvez a busca não esteja disponível nesse caminho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu %lld döndürdü. Adres doğru olsa da arama bu yoldan açılmıyor olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回 %lld。地址可能正确，但该路径下也许并未开放搜索。"
          }
        }
      }
    },
    "The setting stays as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste se queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage reste tel quel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração permanece como está."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayar olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置保持不变。"
          }
        }
      }
    },
    "The store couldn’t be opened. What you write stays only on screen; when you close Tacet, these conversations are gone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher konnte nicht geöffnet werden. Was du schreibst, bleibt nur auf dem Bildschirm; wenn du Tacet schließt, sind diese Unterhaltungen weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el almacén. Lo que escribas solo queda en pantalla; al cerrar Tacet, estas conversaciones desaparecerán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir le stockage. Ce que tu écris reste seulement à l’écran ; en fermant Tacet, ces conversations disparaîtront."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージを開けませんでした。入力した内容は画面上に残るだけで、Tacet を閉じるとこれらの会話は消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소를 열지 못했습니다. 입력한 내용은 화면에만 남으며, Tacet을 닫으면 이 대화는 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o armazenamento. O que você escrever fica só na tela; ao fechar o Tacet, estas conversas serão perdidas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo açılamadı. Yazdıkların yalnızca ekranda duruyor; Tacet'i kapatınca bu sohbetler kaybolur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开存储。你输入的内容仅停留在屏幕上；关闭 Tacet 后，这些对话将消失。"
          }
        }
      }
    },
    "The store where your chats are kept could not be opened on this device, so Tacet cannot start a conversation. Your data has not been deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher mit deinen Chats konnte auf diesem Gerät nicht geöffnet werden, daher kann Tacet kein Gespräch beginnen. Deine Daten wurden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir en este dispositivo el almacén donde se guardan tus chats, así que Tacet no puede iniciar una conversación. Tus datos no se han borrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace où sont conservées tes conversations n'a pas pu être ouvert sur cet appareil, donc Tacet ne peut pas démarrer d'échange. Tes données n'ont pas été supprimées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を保存している領域をこの端末で開けなかったため、Tacet は会話を開始できません。データは削除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 저장된 저장소를 이 기기에서 열 수 없어 Tacet이 대화를 시작할 수 없습니다. 데이터는 삭제되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir neste dispositivo o armazenamento onde suas conversas ficam guardadas, então o Tacet não consegue iniciar a conversa. Seus dados não foram apagados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetlerin saklandığı depo bu cihazda açılamadı, bu yüzden Tacet yazışmayı başlatamıyor. Verilerin silinmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此设备上打开保存对话的存储，因此 Tacet 无法开始对话。你的数据没有被删除。"
          }
        }
      }
    },
    "The system is downloading the on-device model. When it’s done, Tacet works on its own; you don’t need to restart the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System lädt das Modell auf das Gerät. Danach läuft Tacet von selbst; du musst die App nicht neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema está descargando el modelo en el dispositivo. Cuando termine, Tacet funcionará solo; no hace falta reiniciar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système télécharge le modèle sur l’appareil. Une fois terminé, Tacet fonctionne tout seul ; inutile de relancer l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがオンデバイスモデルをダウンロードしています。完了すれば Tacet はひとりでに動きます。アプリを再起動する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 온디바이스 모델을 내려받고 있습니다. 끝나면 Tacet은 알아서 동작합니다. 앱을 다시 시작할 필요는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema está baixando o modelo no dispositivo. Quando terminar, o Tacet funciona sozinho; não precisa reiniciar o app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz-üstü modeli sistem indiriyor. Bittiğinde Tacet kendiliğinden çalışır; uygulamayı yeniden başlatman gerekmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统正在下载设备端模型。完成后 Tacet 会自行运行；无需重启 App。"
          }
        }
      }
    },
    "The table could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabelle konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la tabla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tableau n'a pas pu être lu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표를 읽지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a tabela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablo okunamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取表格。"
          }
        }
      }
    },
    "The task you pick lands in the input field; it runs as soon as you send it. Tacet leaves every tool it touches on screen — you don’t have to read what it did, you see it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Aufgabe landet im Eingabefeld; sobald du sie sendest, läuft sie los. Tacet lässt jedes benutzte Werkzeug am Bildschirm zurück – du musst nicht nachlesen, was es getan hat, du siehst es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea que elijas aparece en el campo de entrada; se ejecuta en cuanto la envías. Tacet deja en pantalla cada herramienta que usa: no tienes que leer lo que hizo, lo ves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche choisie arrive dans le champ de saisie ; elle s’exécute dès que tu l’envoies. Tacet laisse à l’écran chaque outil qu’il utilise — tu n’as pas à lire ce qu’il a fait, tu le vois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだタスクは入力欄に入ります。送信すればすぐ動きます。Tacet は触れたツールをすべて画面に残します。何をしたか読む必要はなく、見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고른 할 일이 입력란에 들어갑니다. 보내면 바로 실행됩니다. Tacet은 사용한 모든 도구를 화면에 남깁니다 — 무엇을 했는지 읽을 필요 없이 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa escolhida cai no campo de entrada; ela roda assim que você envia. O Tacet deixa na tela cada ferramenta que usa — você não precisa ler o que ele fez, você vê."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin iş giriş alanına düşer; gönderdiğinde hemen çalışır. Tacet dokunduğu her aracı ekranda bırakır — ne yaptığını okumana gerek kalmaz, görürsün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选的任务会落到输入框；发送后立即执行。Tacet 会把用过的每个工具留在屏幕上——你不用读它做了什么，你能看见。"
          }
        }
      }
    },
    "The test couldn’t be completed: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test konnte nicht abgeschlossen werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la prueba: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test n’a pas pu aboutir : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストを完了できませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트를 완료하지 못했습니다: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir o teste: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme tamamlanamadı: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试未能完成：%@"
          }
        }
      }
    },
    "The test stopped partway.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test wurde abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se interrumpió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test s’est interrompu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テストが途中で終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트가 중간에 멈췄습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste foi interrompido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme yarıda kaldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试中途停止。"
          }
        }
      }
    },
    "There is no content for the table.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Tabelle ist kein Inhalt vorhanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contenido para la tabla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a aucun contenu pour le tableau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表にする内容がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표로 만들 내용이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há conteúdo para a tabela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablo için içerik yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用于表格的内容。"
          }
        }
      }
    },
    "There’s no on-device recognition model for the selected language on this device. So your voice never leaves the device, dictation stays off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die gewählte Sprache gibt es auf diesem Gerät kein Erkennungsmodell. Damit deine Stimme das Gerät nicht verlässt, bleibt das Diktat aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay modelo de reconocimiento en el dispositivo para el idioma seleccionado. Para que tu voz no salga del dispositivo, el dictado permanece desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle de reconnaissance sur l’appareil pour la langue choisie. Pour que ta voix ne quitte pas l’appareil, la dictée reste désactivée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中の言語のオンデバイス認識モデルがこの端末にありません。声が端末から出ないよう、音声入力はオフのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 언어의 온디바이스 인식 모델이 이 기기에 없습니다. 음성이 기기를 벗어나지 않도록 받아쓰기는 꺼진 채로 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há modelo de reconhecimento no dispositivo para o idioma selecionado. Para sua voz não sair do aparelho, o ditado fica desativado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili dilin cihaz içi tanıma modeli bu cihazda yok. Sesin cihazdan çıkmaması için dikte kapalı kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机没有所选语言的设备端识别模型。为了让语音不离开设备，听写保持关闭。"
          }
        }
      }
    },
    "There’s no space left on the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät ist kein Speicherplatz mehr frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda espacio en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a plus d’espace sur l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の空き容量がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 남은 공간이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há mais espaço no dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda yer kalmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备存储空间已满。"
          }
        }
      }
    },
    "These notes never leave your device. Tacet looks at them when they’re relevant.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notizen verlassen dein Gerät nie. Tacet sieht sie sich an, wenn sie relevant sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas notas no salen de tu dispositivo. Tacet las consulta cuando son relevantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces notes ne quittent jamais ton appareil. Tacet les consulte quand elles sont pertinentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのメモがデバイスから出ることはありません。関連するときに Tacet が参照します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모는 기기 밖으로 나가지 않습니다. 관련이 있을 때 Tacet이 참고합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas notas não saem do seu dispositivo. O Tacet as consulta quando são relevantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu notlar cihazından çıkmaz. İlgili olduklarında Tacet onlara bakar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些备忘录不会离开你的设备。相关时 Tacet 会查看它们。"
          }
        }
      }
    },
    "This address isn’t accepted: use https; plain http only works on a local network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse wird nicht akzeptiert: Verwende https; einfaches http gilt nur im lokalen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección no se acepta: usa https; el http simple solo vale en la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse n’est pas acceptée : utilise https ; le http simple n’est valable que sur le réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは受け付けられません。https を使ってください。平文の http はローカルネットワークでのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소는 사용할 수 없습니다. https를 쓰세요. 일반 http는 로컬 네트워크에서만 유효합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço não é aceito: use https; http simples só vale na rede local."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adres kabul edilmiyor: https kullan; düz http yalnızca yerel ağda geçerli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地址不被接受：请使用 https；纯 http 仅在本地网络中有效。"
          }
        }
      }
    },
    "This conversation has grown too long for me. If you start a new chat and ask again, I can do it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gespräch ist mir zu lang geworden. Wenn du einen neuen Chat öffnest und noch einmal fragst, schaffe ich das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación se me ha hecho demasiado larga. Si abres un chat nuevo y lo preguntas otra vez, podré hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation est devenue trop longue pour moi. Si tu ouvres une nouvelle conversation et redemandes, je pourrai le faire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は私には長くなりすぎました。新しいチャットを開いてもう一度聞いてもらえれば、できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 제게 너무 길어졌습니다. 새 대화를 열고 다시 물어보시면 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa ficou longa demais para mim. Se você abrir uma nova conversa e perguntar de novo, eu consigo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma benim için fazla uzadı. Yeni bir sohbet açıp tekrar sorarsan bunu yapabilirim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话对我来说太长了。新开一个对话再问一次，我就能做到。"
          }
        }
      }
    },
    "This device can’t run Tacet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann Tacet nicht ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede ejecutar Tacet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas exécuter Tacet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では Tacet を動かせません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Tacet을 실행할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não consegue rodar o Tacet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz Tacet'i çalıştıramıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法运行 Tacet。"
          }
        }
      }
    },
    "This device can’t run the on-device model; Tacet can’t produce replies here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann das Modell nicht lokal ausführen; Tacet kann hier keine Antworten erzeugen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede ejecutar el modelo en el dispositivo; Tacet no puede generar respuestas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas exécuter le modèle en local ; Tacet ne peut pas produire de réponses ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では端末内モデルを実行できないため、Tacet はここで返答を生成できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 온디바이스 모델을 실행할 수 없어 Tacet이 여기서 답변을 생성할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não consegue executar o modelo no dispositivo; o Tacet não pode gerar respostas aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz cihaz-üstü modeli çalıştıramıyor; Tacet burada yanıt üretemiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法运行设备端模型，Tacet 在此无法生成回复。"
          }
        }
      }
    },
    "This field couldn’t be simplified: %@": {
