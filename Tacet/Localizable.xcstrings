          }
        }
      }
    },
    "What’s Anna’s number?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie ist die Nummer von Anna?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es el número de Ana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel est le numéro d’Anna ?"
          }
        },
        "ja": {
          "stringUnit": {
