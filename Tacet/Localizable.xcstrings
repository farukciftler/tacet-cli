    "Memory is full — no new notes are being added. Delete a few to make room.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gedächtnis ist voll – es werden keine neuen Notizen hinzugefügt. Lösche einige, um Platz zu schaffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria está llena: no se añaden notas nuevas. Elimina algunas para hacer sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire est pleine — aucune nouvelle note n’est ajoutée. Supprimes-en quelques-unes pour faire de la place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶がいっぱいです。新しいメモは追加されません。いくつか削除して空きを作ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억이 가득 찼습니다. 새 메모가 추가되지 않습니다. 몇 개를 삭제해 공간을 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória está cheia — novas notas não são adicionadas. Exclua algumas para abrir espaço."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafıza dolu — yeni not eklenmiyor. Yer açmak için birkaçını sil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆已满 — 不再添加新备忘录。删除一些以腾出空间。"
          }
        }
      }
    },
