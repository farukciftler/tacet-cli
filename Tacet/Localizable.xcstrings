    "https addresses only. Plain http is accepted only on a local network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur https-Adressen. Einfaches http wird nur im lokalen Netzwerk akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo direcciones https. El http sin cifrar solo se acepta en la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses https uniquement. Le http simple n’est accepté que sur un réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "https のアドレスのみ。暗号化なしの http はローカルネットワークでのみ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https 주소만 가능합니다. 암호화되지 않은 http는 로컬 네트워크에서만 허용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente endereços https. Http sem criptografia só é aceito em rede local."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca https adresi. Düz http yalnızca yerel ağda kabul edilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 https 地址。普通 http 仅在本地网络中被接受。"
          }
        }
      }
    },
