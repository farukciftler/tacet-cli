    "Data is sent to this connection without asking for confirmation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An diese Verbindung wird ohne Bestätigung gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía a esta conexión sin pedir confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont envoyées à cette connexion sans demande de confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続には確認なしで送信されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에는 확인 없이 전송되고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados são enviados para esta conexão sem pedir confirmação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantıya onay sorulmadan gönderiliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送到此连接时不会请求确认。"
          }
        }
      }
    },
    "Data read from your device can be sent to this server without asking you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, die von deinem Gerät gelesen werden, können ohne Nachfrage an diesen Server gesendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos leídos de tu dispositivo pueden enviarse a este servidor sin preguntarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données lues sur ton appareil peuvent être envoyées à ce serveur sans te demander."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスから読み取ったデータが、確認なしにこのサーバーへ送信されることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 읽은 데이터가 확인 없이 이 서버로 전송될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados lidos do seu dispositivo podem ser enviados para este servidor sem perguntar a você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazından okunan veri, sana sorulmadan bu sunucuya gönderilebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的设备读取的数据可能在不询问你的情况下发送到此服务器。"
          }
        }
      }
    },
    "Data read from your device is never sent to this server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, die von deinem Gerät gelesen werden, werden nie an diesen Server gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos leídos de tu dispositivo nunca se envían a este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données lues sur ton appareil ne sont jamais envoyées à ce serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスから読み取ったデータがこのサーバーに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 읽은 데이터는 이 서버로 전혀 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados lidos do seu dispositivo nunca são enviados para este servidor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazından okunan veri bu sunucuya hiç gönderilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的设备读取的数据绝不会发送到此服务器。"
          }
        }
      }
    },
    "Data read from your device is shown to you every time before it is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, die von deinem Gerät gelesen werden, werden dir vor jedem Senden gezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos leídos de tu dispositivo se te muestran cada vez antes de enviarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données lues sur ton appareil te sont montrées chaque fois avant l’envoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスから読み取ったデータは、送信前に毎回表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 읽은 데이터는 전송되기 전에 매번 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados lidos do seu dispositivo são mostrados a você toda vez antes do envio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazından okunan veri gönderilmeden önce her seferinde sana gösterilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的设备读取的数据在发送前每次都会先展示给你。"
          }
        }
      }
    },
