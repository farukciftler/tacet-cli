    "One moment, finishing the previous reply.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Moment, ich beende die vorherige Antwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un momento, estoy terminando la respuesta anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instant, je termine la réponse précédente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少々お待ちください、前の返信を仕上げています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시만요, 이전 응답을 마무리하고 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um momento, estou terminando a resposta anterior."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saniye, önceki yanıtı bitiriyorum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍等，我正在完成上一条回复。"
          }
        }
      }
    },
    "One sentence, up to %lld characters. You can rewrite it in your own words.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Satz, höchstens %lld Zeichen. Du kannst ihn in eigenen Worten ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola frase, máximo %lld caracteres. Puedes corregirla con tus propias palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule phrase, %lld caractères maximum. Tu peux la reformuler à ta façon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 文、最大 %lld 文字。自分の言葉で直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 문장, 최대 %lld자. 직접 자기 말로 고칠 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frase, até %lld caracteres. Você pode reescrevê-la com suas palavras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek cümle, en fazla %lld karakter. Kendi sözlerinle düzeltebilirsin."
