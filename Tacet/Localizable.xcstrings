    "Tap the microphone in the input field; what you say turns into text on this device. The audio goes to no server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Mikrofon im Eingabefeld; was du sagst, wird auf diesem Gerät zu Text. Der Ton geht an keinen Server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el micrófono del campo de entrada; lo que dices se convierte en texto en este dispositivo. El audio no va a ningún servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le micro dans le champ de saisie ; ce que tu dis devient du texte sur cet appareil. L’audio ne part vers aucun serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄のマイクを押すと、話した内容がこの端末で文字になります。音声はどのサーバーにも送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력란의 마이크를 누르면 말한 내용이 이 기기에서 글로 바뀝니다. 음성은 어떤 서버로도 가지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no microfone no campo de entrada; o que você fala vira texto neste aparelho. O áudio não vai para servidor nenhum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş alanındaki mikrofona bas; söylediklerin bu cihazda yazıya döner. Ses hiçbir sunucuya gitmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按输入框里的麦克风；你说的话会在本机转成文字。音频不会发往任何服务器。"
          }
        }
      }
    },
