    }
   ]
  },
  {
   "name": "fetch-rust-book",
   "category": "tool",
   "steps": [
    {
     "message": "open https://doc.rust-lang.org/book/ch01-02-hello-world.html and give me the gist",
     "expect": "web_fetch",
     "forbidden": [
      "web_search"
     ]
    }
   ]
  },
  {
   "name": "thanks-web",
   "category": "irrelevance",
   "steps": [
