     "message": "have there been any big earthquakes reported in the last few days",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "bitcoin-price",
   "category": "tool",
   "steps": [
    {
     "message": "how much is bitcoin going for today?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "japan-pm",
   "category": "tool",
   "steps": [
    {
     "message": "who is the prime minister of Japan these days?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "eur-try",
   "category": "tool",
   "steps": [
    {
     "message": "euro kaç lira şu an?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "apple-event",
   "category": "tool",
   "steps": [
    {
     "message": "what did Apple announce at their latest event? I missed it completely",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "fetch-example",
   "category": "tool",
   "steps": [
    {
     "message": "summarise https://example.com/ for me",
     "expect": "web_fetch",
     "forbidden": [
      "web_search"
     ]
    }
   ]
  },
  {
   "name": "fetch-wikipedia",
   "category": "tool",
   "steps": [
