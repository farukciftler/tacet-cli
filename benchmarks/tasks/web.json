{
 "name": "web",
 "requires": [
  "web_search",
  "web_fetch"
 ],
 "notes": "Web search and fetch, measured against a RECORDED SearXNG. A live search cannot be a benchmark — the answer changes while nobody is looking — so the results are frozen in benchmarks/cassettes/ and replayed with TACET_WEB_CASSETTE. What is scored is ours: did it search rather than answer from memory, did an explicit address go to web_fetch rather than web_search, and did a greeting reach no tool at all.",
 "cases": [
  {
   "name": "dollar-rate-tr",
   "category": "tool",
   "steps": [
    {
     "message": "dolar bugün kaç lira?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "weather-istanbul",
   "category": "tool",
   "steps": [
    {
     "message": "istanbulda hava nasıl olacak yarın?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "newest-rust",
   "category": "tool",
   "steps": [
    {
     "message": "which stable Rust version is the newest one right now",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "air-quality-delhi",
   "category": "tool",
   "steps": [
    {
     "message": "how bad is the air quality in Delhi right now?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "train-strike-france",
   "category": "tool",
   "steps": [
    {
     "message": "is there a train strike going on in France?",
     "expect": "web_search"
    }
   ]
  },
  {
   "name": "who-won-cl",
